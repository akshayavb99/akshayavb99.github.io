---
layout: page
---
{{ content }}

<style>
  .course-year-heading {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 1.5rem 0 0.75rem;
  }

  .course-title {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 1rem 0 0.5rem;
  }
</style>

{% assign courses = site.courses | sort: 'date' | reverse %}
{% assign years = courses | group_by_exp: 'course', "course.date | date: '%Y'" %}

{% if courses.size > 0 %}
  {% for year in years %}
    <h2 class="course-year-heading">
      <a href="{{ year.name | prepend: '/courses-workshops/' | append: '/' | relative_url }}">{{ year.name }}</a>
    </h2>
    <ul>
      {% for course in year.items %}
        <li>
          <article>
            <a href="{{ course.url | relative_url }}">{{ course.title }}</a>
          </article>
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
{% else %}
  <p>No courses or workshops have been added yet.</p>
{% endif %}
